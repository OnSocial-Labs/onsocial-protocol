[Unit]
# OnSocial neardata reader — replaces the dead StreamingFast Substreams sink.
# Polls finalized blocks from neardata and writes them through the same
# decoders into the same Postgres tables. Hasura/app unchanged.
Description=OnSocial neardata reader (testnet indexer)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# DB URL comes from a root-only credential file, never the process env or
# command line (same pattern as the old sink unit).
LoadCredential=db_url:/etc/onsocial/credentials/onsocial-neardata-reader/db_url
LoadCredential=network:/etc/onsocial/credentials/onsocial-neardata-reader/network
# --prefetch 3 overlaps block downloads with decode+commit so the fetch RTT
# is hidden. Keep it low: the neardata cap is 180 req/min/IP and this box
# shares that IP with anything else polling neardata; deep pipelining against
# a shared cap just converts into 429s. Raise --max-rpm and --prefetch
# together only if FastNear grants a private higher tier.
#
# Optional FastNear API key: if
# /etc/onsocial/credentials/onsocial-neardata-reader/api_key exists and is
# non-empty, it is sent as `Authorization: Bearer` (the neardata auth shape
# per the FastNear docs). Read directly rather than via LoadCredential
# because LoadCredential fails the whole unit when the file is absent, and
# the key is optional. When a key is provisioned, also raise --max-rpm /
# --prefetch to whatever the paid tier allows.
ExecStart=/bin/bash -lc 'args=(--db-url "$(cat "${CREDENTIALS_DIRECTORY}/db_url")" --network "$(cat "${CREDENTIALS_DIRECTORY}/network")" --prefetch 3); k=/etc/onsocial/credentials/onsocial-neardata-reader/api_key; if [[ -s "$k" ]]; then args+=(--api-key "$(cat "$k")"); fi; exec /usr/local/bin/neardata_reader "${args[@]}"'
# Restart on any failure (network blip, neardata 5xx, DB hiccup). The reader
# is crash-safe: each block commits rows + cursor in one transaction, so a
# restart replays at most one partially-applied block, which upserts absorb.
Restart=always
RestartSec=10
# Give up only if it cannot stay up for 30s across 5 tries (config error).
StartLimitIntervalSec=150
StartLimitBurst=5
# Reasonable resource ceiling; the reader is light (~tens of MB).
MemoryMax=512M
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
