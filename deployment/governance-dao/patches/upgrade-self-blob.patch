+/// Upgrade this DAO from code previously stored via `store_blob`.
+///
+/// Does not call the parent/factory. Used by OnSocial protocol DAOs
+/// (`*.onsocial.near` / `*.onsocial.testnet`) that are not factory children.
+pub(crate) fn upgrade_self(code_hash: &Base58CryptoHash) {
+    let hash: CryptoHash = (*code_hash).into();
+    let code = env::storage_read(&hash).expect("ERR_NO_HASH");
+    let current_id = env::current_account_id();
+    let promise_id = env::promise_batch_create(&current_id);
+    // Deploy from the DAO's own blob store, then migrate in the same batch.
+    env::promise_batch_action_deploy_contract(promise_id, &code);
+    env::promise_batch_action_function_call_weight(
+        promise_id,
+        "migrate",
+        &[],
+        NO_DEPOSIT,
+        Gas::from_gas(0),
+        GasWeight::default(),
+    );
+    env::promise_return(promise_id);
+}
