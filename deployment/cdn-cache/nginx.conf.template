# Shared disk cache in front of content (/ipfs) and resized images (/insecure).
# The edge sets the key to the public host plus the original path. Accept is
# not part of the key, and the query string is not either: these URLs do not
# use one. Only successful GET responses are stored. 4xx and 5xx are never
# written, even when the upstream response asks to be cached.

proxy_cache_path /var/cache/cdn levels=1:2 keys_zone=cdn:64m
    max_size=${CDN_CACHE_MAX_SIZE}
    inactive=365d
    use_temp_path=off;

map $upstream_cache_status $cdn_x_cache {
    HIT     HIT;
    default MISS;
}

# An empty key would collapse every request onto one entry.
map $http_x_cache_key $cdn_skip_cache {
    ""      1;
    default 0;
}

server_tokens off;
error_log stderr notice;
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 8080;
    access_log off;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $cdn_origin_host;
    proxy_set_header X-Cache-Key "";
    proxy_set_header X-Cdn-Upstream "";

    proxy_ssl_server_name on;
    proxy_ssl_name $http_x_cdn_upstream;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

    # The edge owns the client deadlines. This hop must not add a shorter one.
    proxy_connect_timeout 10s;
    proxy_read_timeout 1d;
    proxy_send_timeout 1d;

    proxy_cache cdn;
    proxy_cache_key $http_x_cache_key;
    proxy_cache_methods GET;
    # 206 is partial content and must not be stored as a full object.
    proxy_cache_valid 200 201 202 203 204 31536000s;
    proxy_cache_lock on;
    proxy_cache_lock_timeout 30s;
    proxy_cache_bypass $cdn_skip_cache;
    proxy_no_cache $cdn_skip_cache;
    proxy_ignore_headers Cache-Control Expires Set-Cookie Vary X-Accel-Expires;
    proxy_hide_header X-Cache;

    add_header X-Cache $cdn_x_cache always;

    # Set before each proxy so the parent Host header sees the right origin.
    set $cdn_origin_host "";

    location /ipfs/ {
        set $cdn_origin_host $http_x_cdn_upstream;
        proxy_pass https://$http_x_cdn_upstream$request_uri;
    }

    location /insecure/ {
        set $cdn_origin_host imgproxy:8080;
        proxy_pass http://imgproxy:8080$request_uri;
    }

    location = /health {
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 404;
    }
}
