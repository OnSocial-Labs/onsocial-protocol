# OnSocial Production Caddyfile
# Auto-TLS via Let's Encrypt
#
# SINGLE PUBLIC ENTRY POINT — only the API gateway is exposed.
# Hasura, Relay, and Postgres are internal-only (Docker network).
# Admin access: SSH tunnel to the server for Hasura Console or Postgres.
#
#   ssh -L 8080:localhost:8080 your-server   # Hasura Console
#   ssh -L 5432:localhost:5432 your-server   # Postgres
#
# DNS records are injected by the deploy scripts.
# The generated Caddyfile should only contain the hostnames for the target
# environment so testnet and mainnet stay explicitly separated.

# ---------- Global: on-demand TLS for *.onsocial.id ----------
# Pages issues per-subdomain certs as requests arrive.
# The "ask" endpoint validates the subdomain before issuing a cert.
{
	on_demand_tls {
		ask http://pages:3456/caddy-ask
	}
}

# ---------- API Gateway (sole public surface) ----------
# Caddy serves the most specific match first, so this block wins
# over the *.onsocial.id wildcard for testnet.onsocial.id / api.onsocial.id.
__SERVER_NAMES__ {
	# 100 req/s per IP — protects infra before requests reach the app
	rate_limit {
		zone per_ip {
			key    {remote_host}
			events 100
			window 1s
		}
	}

	# Telegram webhook → backend (must be before catch-all)
	handle /webhooks/telegram {
		reverse_proxy __BACKEND_UPSTREAM__
	}

	# NEAR JSON-RPC is the gateway. Every other /v1 path is the backend.
	handle /v1/rpc {
		reverse_proxy __GATEWAY_UPSTREAM__
	}

	# Partner Rewards SDK API → backend
	handle /v1/* {
		reverse_proxy __BACKEND_UPSTREAM__
	}

	# Everything else → gateway
	handle {
		reverse_proxy __GATEWAY_UPSTREAM__
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
	}

	request_body {
		max_size 10MB
	}

	log {
		output file /data/logs/gateway.log {
			roll_size 50MB
			roll_keep 5
		}
	}
}

# ---------- IPFS gateway proxy (cdn.{testnet.,}onsocial.id) ----------
# Brand-stable IPFS gateway under our own domain. Reverse-proxies to a
# configured IPFS gateway upstream so users (and on-chain `media` URLs)
# never reference provider-owned hostnames directly. If we ever change
# storage or gateway providers, only the upstream below has to change —
# every already-written CID keeps resolving.
#
# Current default upstream (deploy scripts):
#   statistical-barnacle-3ny44.lighthouseweb3.xyz   # dedicated (Lighthouse Profile)
# Previous / revert:
#   gateway.lighthouse.storage                      # shared public gateway
# Override: LIGHTHOUSE_CDN_UPSTREAM=<host>
#
# /ipfs and /img are filled by the shared disk cache (cdn-cache). The key
# is the public host plus the path: Accept is ignored because the format is
# already in the path, and these URLs do not use a query string. Only 2xx
# responses are stored. The directory is a persistent volume with a size cap,
# and the least recently used files are evicted past that cap.
__CDN_DOMAIN__ {
	encode zstd gzip

	handle /health {
		respond "ok" 200
	}

	@ipfs path /ipfs/*
	handle @ipfs {
		# IPFS content is immutable — cache aggressively at every layer.
		header Cache-Control "public, max-age=31536000, immutable"
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		header -Server

		rate_limit {
			zone cdn_per_ip {
				key    {http.request.header.CF-Connecting-IP}{remote_host}
				events 600
				window 1s
			}
		}

		# The cache stores the upstream response. TLS to the gateway happens
		# on that hop; this one only reuses connections to the cache.
		reverse_proxy cdn-cache:8080 {
			header_up Host {http.request.host}
			header_up X-Cache-Key "{http.request.host}{http.request.orig_uri.path}"
			header_up X-Cdn-Upstream "__CDN_UPSTREAM__"
			# The upstream gateway sets its own CORS headers, which Caddy
			# appends to the ones above — the browser then sees
			# Access-Control-Allow-Origin twice and rejects the response,
			# breaking every crossOrigin="anonymous" load (canvas
			# video-frame capture for scarce covers). Drop the upstream
			# copies of the two we set so ours stay authoritative; the rest
			# of the upstream CORS headers pass through untouched.
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Methods
			transport http {
				keepalive 60s
			}
		}
	}

	# ---------- Image variants ----------
	# /img/<w>/<avif|webp>/ipfs/<cid>[/<seat>.<ext>] is exactly that format.
	# /img/<w>/ipfs/<cid>[/<seat>.<ext>] is always the original format.
	# The edge cache keys on the URL and ignores Accept, so a URL must not
	# negotiate. Widths are locked — 128 avatars, 384 quote thumbs, 1080
	# feed tiles, 1920 enlarge — and the regex is the allowlist: any other
	# width or format 404s. The optional seat group is variation art
	# (`/ipfs/<cid>/3.png`): numeric stems and an image extension only.
	# Gif and svg pass through byte-identical. Each URL is one cache fill.
	# Canonical /ipfs URLs always serve the byte-original.
	@imgVariant path_regexp img ^/img/(128|384|1080|1920)(?:/(avif|webp))?/ipfs/([A-Za-z0-9]+)(/[0-9]+\.(?i:png|jpe?g|webp|gif|svg))?$
	handle @imgVariant {
		# Empty format stays on the original bytes. avif and webp are explicit.
		map {http.regexp.img.2} {img_format_prefix} {
			avif format:avif/
			webp format:webp/
			default ""
		}
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		header -Server

		rate_limit {
			zone cdn_per_ip {
				key    {http.request.header.CF-Connecting-IP}{remote_host}
				events 600
				window 1s
			}
		}

		rewrite * /insecure/resize:fit:{http.regexp.img.1}:0/{img_format_prefix}plain/https://__CDN_UPSTREAM__/ipfs/{http.regexp.img.3}{http.regexp.img.4}
		reverse_proxy cdn-cache:8080 {
			header_up Host {http.request.host}
			header_up X-Cache-Key "{http.request.host}{http.request.orig_uri.path}"
			# reverse_proxy appends upstream header values, so drop
			# the resize service's copies of anything set above (and its
			# Server banner) — otherwise clients see duplicate Cache-Control /
			# CORS headers. It also sends its own year-long Cache-Control
			# by default, including on failures.
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Methods
			header_down -Cache-Control
			header_down -Server
			# Stay above the 20s resize deadline so a slow source can
			# finish or fail as an HTTP error instead of a cut connection.
			transport http {
				response_header_timeout 30s
				read_timeout 30s
				write_timeout 30s
			}
			# Successful variants of immutable content stay immutable.
			# Error statuses must not: a long max-age would pin a 504 at
			# the edge. No immutable directive on this branch.
			@imgOk status 2xx
			handle_response @imgOk {
				header Cache-Control "public, max-age=31536000, immutable"
				copy_response
			}
			@imgFail status 4xx 5xx
			handle_response @imgFail {
				header Cache-Control "no-store"
				copy_response
			}
		}
	}

	handle {
		header X-Cache "MISS"
		respond 404
	}

	log {
		output file /data/logs/cdn.log {
			roll_size 50MB
			roll_keep 5
		}
	}
}

# ---------- Pages — profile subdomains ----------
# Use a catch-all HTTPS server with on-demand TLS so Caddy issues
# individual subdomain certs at handshake time instead of trying to
# automate a wildcard certificate at startup.
https:// {
	tls {
		on_demand
	}

	@pages host __PAGES_HOST_PATTERNS__
	handle @pages {
		rate_limit {
			zone pages_per_ip {
				key    {remote_host}
				events 30
				window 1s
			}
		}

		reverse_proxy pages:3456

		header {
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
			-Server
		}
	}

	handle {
		abort
	}

	log {
		output file /data/logs/pages.log {
			roll_size 50MB
			roll_keep 5
		}
	}
}
