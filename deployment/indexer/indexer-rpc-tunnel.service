[Unit]
Description=Forward the node RPC to the data host loopback
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Separate from the Postgres tunnel so a forward failure does not drop the indexer database.
# Remote sshd keeps this on 127.0.0.1. The data host bridge publishes it to Docker only.
ExecStart=/usr/bin/ssh -N -i /root/.ssh/indexer_db_tunnel -o BatchMode=yes -o IdentitiesOnly=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -R 127.0.0.1:3030:127.0.0.1:3030 root@135.181.110.183
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
